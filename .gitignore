# Gradle & build caches
.gradle/
build/
**/build/
.kotlin/
**/.kotlin/
.idea/
*.iml
local.properties
.DS_Store

# Temporary & intermediate patcher files
tools/patcher-data/
tools/APKEditor*.jar

# Binary APK files (host binaries on the release page)
*.apk
*.apk.idsig
*.mpp
output/patching-result*.json
!prebuilt/*.mpp
!output/.gitkeep
!patches/*.mpp

# Local input files (never commit stock APKs)
input/*.apk
input/splits*/
!input/.gitkeep

# Log files
*.log

# Scratch directory
scratch/
output/tmp*/

# Reverse-engineering dumps (regenerated on demand, never commit)
output/stock-*/
output/patched-dex-*/
output/*-stock.txt
output/settings-xmltree.txt
